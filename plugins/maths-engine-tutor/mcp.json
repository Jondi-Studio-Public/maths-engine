{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "maths-engine": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "maths-engine[mcp] @ git+https://github.com/Jondi-Studio-Public/maths-engine@v0.2.0",
        "mathgen-mcp",
        "--role",
        "learner",
        "--out-dir",
        "${PLUGIN_DATA}/exports"
      ]
    }
  }
}
